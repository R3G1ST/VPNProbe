<Window x:Class="VPNProbe.Views.SavedLinksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сохранённые ссылки" Height="420" Width="560"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize">

    <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#060610" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Сохранённые ссылки" Foreground="{StaticResource TextSecondary}" FontSize="11"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Button x:Name="BtnClose" Content="✕" Width="36" Height="28" Click="BtnClose_Click"
                            HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource Red}"
                            BorderThickness="0" FontSize="12" Cursor="Hand"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="12,8,12,6" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Выберите ссылку или добавьте новую" Grid.Column="0"
                               Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="＋ Добавить" Style="{StaticResource AccentButton}"
                            Click="BtnAdd_Click" FontSize="11" Padding="10,4" Margin="0,0,6,0"/>
                    <Button Grid.Column="2" Content="▶ Выбрать" x:Name="BtnSelect" Style="{StaticResource AccentButton}"
                            Click="BtnSelect_Click" FontSize="11" Padding="10,4" IsEnabled="False"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="12,0,12,6" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="LinksList"/>
                </ScrollViewer>
            </Border>

            <!-- Add Panel (hidden by default) -->
            <Border x:Name="AddPanel" Grid.Row="2" Style="{StaticResource CardBorder}" Margin="12,0,12,6"
                    Padding="12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="URL подписки:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="AddUrlInput" Style="{StaticResource DarkTextBox}" Height="28"
                             TextWrapping="NoWrap" VerticalContentAlignment="Center" Text="https://"/>
                    <TextBlock Text="Название (авто):" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,8,0,4"/>
                    <TextBox x:Name="AddNameInput" Style="{StaticResource DarkTextBox}" Height="28"
                             TextWrapping="NoWrap" VerticalContentAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Сохранить" Style="{StaticResource AccentButton}" Click="BtnAddConfirm_Click"
                                FontSize="11" Padding="12,4"/>
                        <Button Content="Отмена" Click="BtnAddCancel_Click" FontSize="11" Padding="12,4" Margin="8,0,0,0"
                                Background="Transparent" Foreground="{StaticResource TextSecondary}" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="3" x:Name="StatusText" Text="" Foreground="{StaticResource TextSecondary}"
                       FontSize="10" Margin="12,0,12,8"/>
        </Grid>
    </Border>
</Window>
